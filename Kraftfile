spec: v0.7

name: ukc-runner-controller

runtime: base-compat:latest

targets:
  - kraftcloud/x86_64

rootfs:
  source: ./Dockerfile
  format: erofs

cmd:
  - /usr/bin/ukc-runner-controller
  - run
  - --config=/data/config.yaml
  - --database=/data/ukc-runner-controller.db
  - --listen=0.0.0.0:8080
